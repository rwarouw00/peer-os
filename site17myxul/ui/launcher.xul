<?xml version="1.0" encoding="UTF-8"?>
<?xul-service Settings myxul.service.SettingsService?>
<!-- The myxul launcher: opens the apps in apps/, in front of the background
     chosen in Settings. It is a XUL file like any app. -->
<window id="launcher" title="myxul" width="600" height="440"
        onload="Launcher.start()"
        xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul">

    <script>
        var Launcher = {
            start: function () {
                this.paint();
                var self = this;
                Settings.setOnChange(function () { self.paint(); });   // a new background shows at once
            },
            paint: function () {
                document.getElementById("desktop").setAttribute("style",
                    "background-image: url('" + Settings.getBackgroundURL() + "'); background-size: cover; " +
                    "background-position: center; padding: 18px;");
            }
        };

        function launch(path) {
            window.open(path);
            document.getElementById("status").value = "Opened " + path;
        }
    </script>

    <vbox id="desktop" flex="1">
        <vbox id="panel" spacing="10"
              style="background-color: rgba(250, 250, 250, 0.9); padding: 16px; border-radius: 8px;">
            <label value="myxul" style="font-size: 22px; font-weight: bold;"/>
            <description>XUL applications on Java 8, JavaFX and Nashorn. Choose one to open:</description>
            <grid>
                <columns>
                    <column/>
                    <column flex="1"/>
                </columns>
                <rows>
                    <row align="center">
                        <button id="open-leafpad" label="Leafpad XUL" accesskey="L" oncommand="launch('../apps/leafpad/leafpad.xul')"/>
                        <label value="A plain-text editor, as on Lubuntu"/>
                    </row>
                    <row align="center">
                        <button id="open-abiword" label="AbiWord XUL" accesskey="A" oncommand="launch('../apps/abiword/abiword.xul')"/>
                        <label value="A word processor's shell: toolbars, pages, sidebar"/>
                    </row>
                    <row align="center">
                        <button id="open-terminal" label="Terminal" accesskey="T" oncommand="launch('../apps/terminal/terminal.xul')"/>
                        <label value="Run JavaScript, as any myxul app can"/>
                    </row>
                    <row align="center">
                        <button id="open-browser" label="Web Browser" accesskey="W" oncommand="launch('../apps/web-browser/browser.xul')"/>
                        <label value="Web pages, in JavaFX's WebKit"/>
                    </row>
                    <row align="center">
                        <button id="open-settings" label="Settings" accesskey="S" oncommand="launch('../apps/settings/settings.xul')"/>
                        <label value="The background, and notifications"/>
                    </row>
                    <row align="center">
                        <button id="open-desktop" label="Desktop" accesskey="D" oncommand="launch('desktop.xul')"/>
                        <label value="Skylight OS's desktop, with every app on it"/>
                    </row>
                    <row align="center">
                        <button id="open-gallery" label="Gallery" accesskey="G" oncommand="launch('../apps/gallery/gallery.xul')"/>
                        <label value="Every XUL element myxul knows, working"/>
                    </row>
                </rows>
            </grid>
            <hbox align="center">
                <label id="status" value="" flex="1" style="color: #555555;"/>
                <button label="Quit" oncommand="window.close()"/>
            </hbox>
        </vbox>
        <spacer flex="1"/>
    </vbox>
</window>
