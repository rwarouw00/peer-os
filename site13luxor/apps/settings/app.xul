<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings: desktop background, and how long notifications stay on screen. -->
<xul>
	<icon id="BACKGROUND_1" ref="images/backgrounds/thumbs/1.jpg"/>
	<icon id="BACKGROUND_2" ref="images/backgrounds/thumbs/2.jpg"/>
	<icon id="BACKGROUND_3" ref="images/backgrounds/thumbs/3.jpg"/>
	<icon id="BACKGROUND_4" ref="images/backgrounds/thumbs/4.jpg"/>
	<icon id="BACKGROUND_5" ref="images/backgrounds/thumbs/5.jpg"/>
	<icon id="BACKGROUND_6" ref="images/backgrounds/thumbs/6.jpg"/>
	<vbox id="settings">
		<label value="Background" style="font: 13 bold sans-serif;"/>
		<hbox>
			<button id="background1" label="" icon="BACKGROUND_1" command="choose1"/>
			<button id="background2" label="" icon="BACKGROUND_2" command="choose2"/>
			<button id="background3" label="" icon="BACKGROUND_3" command="choose3"/>
		</hbox>
		<hbox>
			<button id="background4" label="" icon="BACKGROUND_4" command="choose4"/>
			<button id="background5" label="" icon="BACKGROUND_5" command="choose5"/>
			<button id="background6" label="" icon="BACKGROUND_6" command="choose6"/>
		</hbox>
		<spacer style="height: 10;"/>
		<label value="Notifications" style="font: 13 bold sans-serif;"/>
		<hbox>
			<label value="Show notifications for "/>
			<textbox id="seconds" cols="3"/>
			<label value=" seconds  "/>
			<button label="Save" command="saveTime"/>
			<spacer flex="1"/>
		</hbox>
		<spacer flex="1"/>
	</vbox>
</xul>
